# ==============================================================================
# Conecta Nexus - API Gateway Environment Configuration
# ==============================================================================

# Gateway HTTP Listening Port
GATEWAY_PORT=80

# Internal Service Upstreams (Default Docker network aliases)
AUTH_UPSTREAM=auth:8000
PROFILE_UPSTREAM=profile:8000
CHALLENGE_UPSTREAM=challenge:8000
APPLICATION_UPSTREAM=application:8000
MODERATION_UPSTREAM=moderation:8000
NOTIFICATION_UPSTREAM=notification:8000
FRONTEND_UPSTREAM=frontend:3000
