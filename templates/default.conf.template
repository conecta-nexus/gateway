# ==============================================================================
# Gateway Server Block (Cloud Run & Local Container Compatible)
# ==============================================================================
server {
    listen ${PORT};
    server_name localhost;

    client_max_body_size 25M;

    # DNS resolver for dynamic domain resolution
    resolver 8.8.8.8 1.1.1.1 169.254.169.254 valid=30s;

    # Global proxy settings
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_http_version 1.1;

    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;

    proxy_read_timeout 90;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;

    # --------------------------------------------------------------------------
    # Custom Standard JSON Error Responses
    # --------------------------------------------------------------------------
    error_page 401 = @error401;
    location @error401 {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        add_header 'WWW-Authenticate' 'Bearer' always;
        return 401 '{"detail":"Unauthorized: Missing, invalid, or expired Bearer access token"}\n';
    }

    error_page 403 = @error403;
    location @error403 {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        return 403 '{"detail":"Forbidden: Access denied"}\n';
    }

    error_page 502 = @error502;
    location @error502 {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        return 502 '{"detail":"Bad Gateway: Upstream microservice is unavailable"}\n';
    }

    error_page 504 = @error504;
    location @error504 {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        return 504 '{"detail":"Gateway Timeout: Upstream microservice timed out"}\n';
    }

    # --------------------------------------------------------------------------
    # Gateway Health Check
    # --------------------------------------------------------------------------
    location = /gateway/health {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        return 200 '{"status":"healthy","service":"gateway"}\n';
    }

    # --------------------------------------------------------------------------
    # Internal Token Verification Subrequest (consumed by auth_request)
    # --------------------------------------------------------------------------
    location = /_auth_verify {
        internal;
        proxy_pass ${AUTH_URL}/api/v1/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_method GET;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
    }

    # --------------------------------------------------------------------------
    # Public Auth Service Routes (/api/v1/auth/)
    # --------------------------------------------------------------------------
    location /api/v1/auth/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, X-User-Id, X-User-Email, X-User-Role, X-User-Scopes' always;

        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${AUTH_URL};
    }

    location = /api/v1/auth {
        return 301 /api/v1/auth/;
    }

    # --------------------------------------------------------------------------
    # Protected Microservice Routes (Validated via RS256 JWT auth_request)
    # --------------------------------------------------------------------------

    # Profile Microservice (/api/v1/profile/ & /api/v1/profiles/)
    location ~ ^/api/v1/profile(s)?(/.*)?$ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        auth_request /_auth_verify;

        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_email $upstream_http_x_user_email;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_scopes $upstream_http_x_user_scopes;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Scopes $auth_user_scopes;
        proxy_set_header Authorization $http_authorization;

        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, X-User-Id, X-User-Email, X-User-Role, X-User-Scopes' always;

        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${PROFILE_URL};
    }

    # Challenge Microservice (/api/v1/challenge/ & /api/v1/challenges/)
    location ~ ^/api/v1/challenge(s)?(/.*)?$ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        auth_request /_auth_verify;

        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_email $upstream_http_x_user_email;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_scopes $upstream_http_x_user_scopes;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Scopes $auth_user_scopes;
        proxy_set_header Authorization $http_authorization;

        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, X-User-Id, X-User-Email, X-User-Role, X-User-Scopes' always;

        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${CHALLENGE_URL};
    }

    # Application Microservice (/api/v1/application/ & /api/v1/applications/)
    location ~ ^/api/v1/application(s)?(/.*)?$ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        auth_request /_auth_verify;

        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_email $upstream_http_x_user_email;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_scopes $upstream_http_x_user_scopes;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Scopes $auth_user_scopes;
        proxy_set_header Authorization $http_authorization;

        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, X-User-Id, X-User-Email, X-User-Role, X-User-Scopes' always;

        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${APPLICATION_URL};
    }

    # Moderation Microservice (/api/v1/moderation/ & /api/v1/moderations/)
    location ~ ^/api/v1/moderation(s)?(/.*)?$ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        auth_request /_auth_verify;

        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_email $upstream_http_x_user_email;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_scopes $upstream_http_x_user_scopes;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Scopes $auth_user_scopes;
        proxy_set_header Authorization $http_authorization;

        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, X-User-Id, X-User-Email, X-User-Role, X-User-Scopes' always;

        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${MODERATION_URL};
    }

    # Notification Microservice (/api/v1/notification/ & /api/v1/notifications/)
    location ~ ^/api/v1/notification(s)?(/.*)?$ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
            add_header 'Access-Control-Max-Age' 86400 always;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        auth_request /_auth_verify;

        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_email $upstream_http_x_user_email;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_scopes $upstream_http_x_user_scopes;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Scopes $auth_user_scopes;
        proxy_set_header Authorization $http_authorization;

        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept, Origin, User-Agent, DNT, Cache-Control, X-Mx-ReqToken, Keep-Alive, X-Requested-With, If-Modified-Since' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, X-User-Id, X-User-Email, X-User-Role, X-User-Scopes' always;

        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${NOTIFICATION_URL};
    }

    # --------------------------------------------------------------------------
    # Direct Service Diagnostics & Root Inspection (/services/<service>/)
    # --------------------------------------------------------------------------
    location /services/auth/ {
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${AUTH_URL}/;
    }

    location /services/profile/ {
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${PROFILE_URL}/;
    }

    location /services/challenge/ {
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${CHALLENGE_URL}/;
    }

    location /services/application/ {
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${APPLICATION_URL}/;
    }

    location /services/moderation/ {
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${MODERATION_URL}/;
    }

    location /services/notification/ {
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_pass ${NOTIFICATION_URL}/;
    }

    # --------------------------------------------------------------------------
    # Frontend (Nuxt 4 / Vue 3) with WebSocket & Vite HMR Support
    # --------------------------------------------------------------------------
    location / {
        proxy_pass ${FRONTEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
    }
}
